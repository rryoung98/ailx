{
	"$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",

	// The repo's linter. There was none before: `apps/web`'s "lint" was
	// `next lint || true`, which cannot fail, so nothing was ever checked.
	//
	// Policy (AGENTS.md: right-sized, minimal diff; FRONTEND.md 7: no ceremony):
	//   error — a real defect. `pnpm lint` and CI fail. This set is green today.
	//   warn  — a known debt with a fix that is a behaviour change, not a
	//           rename. Printed on every run, never blocks. Promote a rule to
	//           error in the commit that clears its last site.
	//   off   — wrong for THIS repo, with the reason written down.
	//
	// A rule set nobody can keep green is a rule set everybody ignores.
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!**/.next",
			"!**/out",
			"!**/coverage",
			"!**/*.svg",
			"!**/test-results",
			"!**/playwright-report",
			"!pnpm-lock.yaml"
		]
	},

	// OFF, deliberately. 310 of 419 files disagree with Biome's formatter, and a
	// 310-file reformat is not a reviewable commit — it would also collide with
	// every branch in flight. Style is enforced by review here, as it always was.
	// Turn this on the day someone is willing to land the reformat on its own.
	"formatter": { "enabled": false },

	"javascript": {
		"formatter": { "quoteStyle": "double", "semicolons": "always" }
	},

	// Import sorting is a formatting change in disguise: it would rewrite the top
	// of nearly every file for no defect. Same trigger as the formatter.
	"assist": { "actions": { "source": { "organizeImports": "off" } } },

	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",

			"a11y": {
				// "Accessibility is measurement fairness" (FRONTEND.md 1) — so these
				// are debt to clear, not rules to delete. Counts are current; see
				// docs/DEBT.md for the per-rule reading.
				"useButtonType": "warn", // 41: adding type="button" changes submit behaviour; needs per-site review
				"useAriaPropsSupportedByRole": "warn", // 0 left; promote to error once a second pass confirms it stays there
				"noSvgWithoutTitle": "warn", // 0 left
				"noRedundantAlt": "warn", // 2, alt wording in the T4 runner
				"noAriaHiddenOnFocusable": "warn", // 1, the HeroCanvas decorative layer
				"noNoninteractiveTabindex": "warn", // 1
				// The rule's fix is <fieldset>, which carries form-control semantics
				// and default styling. The 5 sites are labelled content groups, not
				// form groups (wall, GalleryView x2, ShareTargets, Teaser).
				"useSemanticElements": "off"
			},

			"correctness": {
				"useExhaustiveDependencies": "warn", // 32: read every one; all are deliberate one-shot or trigger effects, and React Compiler (FRONTEND.md 7.3) changes the answer
				"noUnusedImports": "warn", // 0 left
				"noUnusedVariables": "warn", // 0 left
				"noUnusedFunctionParameters": "warn", // 1, a test fetch stub
				"noUnusedPrivateClassMembers": "warn" // 1, a test fake
			},

			"suspicious": {
				"noArrayIndexKey": "warn", // 14: correct where the list is fixed and unordered; wrong where it is not
				"noExplicitAny": "warn", // 10
				// `document.cookie` is the documented dev-auth transport: AGENTS.md
				// requires `ailx_dev_user` to be written next to the localStorage key,
				// because a header cannot survive a navigation.
				"noDocumentCookie": "off"
			},

			"complexity": {
				// All 13 sites are in globals.css and each overrides a declaration it
				// does not own: the reduced-motion resets, the three.js canvas size
				// (three writes width/height inline), and the 16px iOS zoom guard.
				"noImportantStyles": "off"
			},

			"performance": {
				// `next.config.mjs` sets `images: { unoptimized: true }` for the static
				// export, so next/image optimizes nothing and would bypass assetUrl().
				"noImgElement": "off"
			},

			"style": {
				// 866 sites. This codebase asserts an invariant and then indexes: the
				// assertion IS the check, and `!` is how it is spelled. Enforcing this
				// would be a 866-site rewrite that removes no defect.
				"noNonNullAssertion": "off",
				"noDescendingSpecificity": "warn" // 7, in the hand-tuned landing stylesheet
			}
		}
	},

	"overrides": [
		{
			// Playwright's fixture signature is literally `async ({}, use) => …`.
			"includes": ["apps/web/e2e/**"],
			"linter": { "rules": { "correctness": { "noEmptyPattern": "off" } } }
		},
		{
			// `noFocusedTests` flags any call to `fit(`, which is Jasmine's focused
			// test — and also SwipeDeck's local layout function. Keep the rule where
			// a stray `.only` actually costs coverage: in the test files.
			"includes": ["**/src/**", "**/lib/**", "**/app/**"],
			"linter": { "rules": { "suspicious": { "noFocusedTests": "off" } } }
		}
	]
}
